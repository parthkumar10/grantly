# Public client settings: Supabase publishable key only, NEVER the service secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Private server settings. Never prefix these with VITE_ or NEXT_PUBLIC_.
GEMINI_API_KEY=
# Choose a current model available in your Google AI Studio project.
GEMINI_MODEL=gemini-3.1-flash-lite
# Production always requires sign-in. Enable this to require it locally too.
AI_REQUIRE_AUTH=false
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Optional email delivery is deliberately not enabled in this release.
# No Resend key is needed; only in-app reminders are implemented.
